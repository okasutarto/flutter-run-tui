# ============================================================
# State
# ============================================================

buffer = ""

flutter_started = False
application_prepared = False

pods_started = False
pods_completed = False
pods_duration = ""

xcode_started = False
xcode_completed = False
xcode_duration = ""

gradle_started = False
gradle_completed = False
gradle_task = ""
gradle_duration = ""

install_started = False
install_completed = False
install_duration = ""

sync_started = False
sync_completed = False

interactive_ready = False

# True while passing through a logger.printBox() block from Flutter.
in_box = False

# ============================================================
# Pending hot reload / hot restart
# ============================================================
# A keypress is only a request. Flutter decides whether to honour it,
# and when it declines it says nothing at all on stdout:
#
#   - busy with a previous command  -> processTerminalInput() drops the
#     key with a printTrace() (resident_runner.dart)
#   - restart unsupported / not hot mode -> 'R' returns false silently
#
# So the spinner is driven off Flutter's own progress message instead:
#
#   request  keypress                -> spinner, waiting for ack
#   ack      "Performing hot ..."    -> Flutter accepted it
#   done     "Restarted application in ..." / "Reloaded ... in ..."
#   failed   "Try again after fixing ..." / rejected / failed
#   dropped  no ack within ACK_TIMEOUT
#
# Without the dropped case the spinner had no terminating condition and
# simply ran forever.

pending_kind = None
pending_acked = False
pending_ack_at = None
pending_failure = ""
pending_notice = ""

# kind -> (spinner label, report name, colour, key)
PENDING_LABELS = {
    "reload": (
        "Hot Reloading...",
        "Hot reload",
        CYAN,
        "r",
    ),
    "restart": (
        "Hot Restarting...",
        "Hot restart",
        YELLOW,
        "R",
    ),
}

ACK_MARKERS = (
    ("Performing hot restart", "restart"),
    ("Performing hot reload", "reload"),
)

# Why a reload is taking its time. run_hot.dart hands this to its onSlow
# callback, which cancels the "Performing hot reload..." progress and
# opens a new one carrying this text instead (_describePausedIsolates).
# It's a progress message, so Flutter redraws it on the same row - but
# every redraw reaches us as another complete line.
PAUSED_STATUS_RE = re.compile(
    r"^(?:The application is|[0-9]+ isolates are)\s+paused\b"
)


def begin_pending(kind, acked=False):
    global pending_kind
    global pending_acked
    global pending_ack_at

    label, _, color, _ = PENDING_LABELS[kind]

    pending_kind = kind
    pending_acked = acked

    if acked:
        pending_ack_at = None
    else:
        pending_ack_at = time.monotonic() + ACK_TIMEOUT

    start_spinner(
        label,
        color,
        show_elapsed=True,
    )


def request_pending(kind):
    """Handle a keypress."""

    # Already running and confirmed: Flutter will ignore the extra key,
    # so keep the stage that is actually in flight rather than resetting
    # its ack window.
    if pending_kind == kind and pending_acked:
        return

    begin_pending(kind)


def ack_pending(kind):
    global pending_acked
    global pending_ack_at

    if pending_kind != kind:
        # Either nothing was pending (a restart triggered from outside
        # frun, or one Flutter had queued) or the other stage won. Adopt
        # what Flutter is actually doing.
        begin_pending(kind, acked=True)
        return

    pending_acked = True
    pending_ack_at = None


def note_pending_failure(reason):
    """Remember why a stage is going to fail.

    Flutter prints the cause before it prints the closing "Try again"
    line, so the reason is known ahead of the verdict.
    """

    global pending_failure

    if not pending_failure:
        pending_failure = reason


def clear_pending():
    global pending_kind
    global pending_acked
    global pending_ack_at
    global pending_failure
    global pending_notice

    pending_kind = None
    pending_acked = False
    pending_ack_at = None
    pending_failure = ""
    pending_notice = ""


def finish_pending(kind, duration=""):
    """Close out an operation.

    `kind` is what Flutter reported, which wins over what frun thought
    was pending: a reload/restart can also be triggered from outside
    frun, or be one Flutter had queued.
    """

    _, name, _, _ = PENDING_LABELS[kind]

    complete_spinner(
        f"{name} complete",
        duration,
    )

    clear_pending()


def fail_pending(reason=""):
    if pending_kind is None:
        return

    _, name, _, _ = PENDING_LABELS[pending_kind]

    stop_spinner()

    suffix = ""

    if reason:
        suffix = f"  {reason}"

    line(
        f"  ✗ {name} failed{suffix}",
        RED + BOLD,
    )

    clear_pending()


def drop_pending():
    """The ack never arrived, so Flutter never took the key.

    Either it was busy with an earlier command or the run doesn't
    support the operation (profile/release build, non-hot mode). Flutter
    reports neither case on stdout, so say so here.
    """

    if pending_kind is None:
        return

    _, name, _, key = PENDING_LABELS[pending_kind]

    stop_spinner()

    line(
        f"  ⚠ {name} not picked up by Flutter — press {key} again",
        YELLOW + BOLD,
    )

    clear_pending()


def check_pending_ack(partial):
    """Look for the ack in the not-yet-terminated tail of the stream.

    Flutter's progress message is written without a newline and stays
    open for the whole operation (SpinnerStatus in
    flutter_tools/lib/src/base/logger.dart), so waiting for a complete
    line would mean waiting until the restart has already finished. On a
    quiet app that is the only thing standing between a dropped key and
    a spinner that never resolves.
    """

    if pending_kind is None or pending_acked:
        return

    if not partial:
        return

    text = clean_ansi(partial)

    for marker, kind in ACK_MARKERS:
        if marker in text:
            ack_pending(kind)
            return


# ============================================================
# Flutter output parser
# ============================================================

def process_line(raw_line):
    global flutter_started
    global application_prepared

    global pods_started
    global pods_completed
    global pods_duration

    global xcode_started
    global xcode_completed
    global xcode_duration

    global gradle_started
    global gradle_completed
    global gradle_task
    global gradle_duration

    global install_started
    global install_completed
    global install_duration

    global sync_started
    global sync_completed

    global interactive_ready

    global app_logs_at

    global in_box

    global pending_notice

    text = clean_ansi(
        raw_line
    ).strip()

    if not text:
        return

    if is_progress_artifact(text):
        return

    # --------------------------------------------------------
    # Flutter's own boxed notices
    # --------------------------------------------------------
    # logger.printBox() output: the "A new version of Flutter is
    # available!" warning, Flutter Fix hints, and similar. Plain
    # `flutter run` prints these inline before the build, so pass them
    # straight through instead of buffering them until APP LOGS.
    #
    # _generateBox in flutter_tools/lib/src/base/logger.dart draws with
    # light box characters:
    #
    #   ┌─ [title] ─┐
    #   │ message   │
    #   └───────────┘
    #
    # The spinner has to stop first, otherwise it overwrites the box
    # as it redraws.

    if text.startswith("┌"):
        in_box = True

        stop_spinner()
        native(text)
        return

    if in_box:
        native(text)

        if text.startswith("└"):
            in_box = False

        return

    # --------------------------------------------------------
    # Flutter started
    # --------------------------------------------------------

    if text.startswith(
        "Launching lib/main.dart"
    ):
        if not flutter_started:
            complete_spinner(
                "Flutter started"
            )

            flutter_started = True

        # Don't print Flutter's raw Launching line.
        # Selected target is already displayed by frun.

        if not application_prepared:
            start_spinner(
                "Preparing application...",
                YELLOW,
            )

        return

    # --------------------------------------------------------
    # CocoaPods
    # --------------------------------------------------------

    if "Running pod install" in text:
        if not application_prepared:
            complete_spinner(
                "Application prepared"
            )

            application_prepared = True

        # Same CR-animated pattern as the Gradle line: Flutter
        # re-emits it with the elapsed time once pods finish.
        duration = extract_duration(text)

        if duration:
            if not pods_completed:
                pods_duration = duration

                complete_spinner(
                    "CocoaPods installed",
                    duration,
                )

                pods_completed = True

            return

        if not pods_started:
            start_spinner(
                "Installing CocoaPods dependencies...",
                PURPLE,
            )

            pods_started = True

        return

    # --------------------------------------------------------
    # Xcode
    # --------------------------------------------------------

    if "Running Xcode build" in text:
        if not application_prepared:
            complete_spinner(
                "Application prepared"
            )

            application_prepared = True

        # Fallback for CocoaPods: if pods ran but never reported a
        # duration, close that stage here instead of letting
        # stop_spinner() silently erase it.
        if pods_started and not pods_completed:
            complete_spinner(
                "CocoaPods installed",
                pods_duration,
            )

            pods_completed = True
        else:
            stop_spinner()

        if not xcode_started:
            start_spinner(
                "Building with Xcode...",
                PURPLE,
            )

            xcode_started = True

        return

    if "Xcode build done" in text:
        if not xcode_completed:
            xcode_duration = extract_duration(
                text
            )

            complete_spinner(
                "Xcode build complete",
                xcode_duration,
            )

            xcode_completed = True

        return

    if "Compiling, linking and signing" in text:
        return

    # --------------------------------------------------------
    # Gradle
    # --------------------------------------------------------

    if "Running Gradle task" in text:
        if not application_prepared:
            complete_spinner(
                "Application prepared"
            )

            application_prepared = True

        # Flutter animates this line via CR and appends an elapsed
        # time to it. Intermediate CR updates can already carry a
        # partial elapsed value, so treating the first one we see as
        # completion reports a far too short build. Keep overwriting
        # instead, and let "Built build/..." decide when Gradle is
        # actually done.
        duration = extract_duration(text)

        if duration:
            gradle_duration = duration

        if not gradle_started:
            gradle_task = extract_gradle_task(text)

            label = "Building with Gradle"

            if gradle_task:
                label = (
                    f"Building with Gradle "
                    f"({gradle_task})"
                )

            start_spinner(
                f"{label}...",
                PURPLE,
            )

            gradle_started = True

        return

    if (
        "Built build/" in text
        or text.startswith("✓ Built")
    ):
        # This is the unambiguous "Gradle finished" signal, so the
        # elapsed time captured off the Gradle line is final here.
        if not gradle_completed:
            complete_spinner(
                "Gradle build complete",
                gradle_duration,
            )

            gradle_completed = True

        return

    # --------------------------------------------------------
    # Android APK installation
    # --------------------------------------------------------

    if text.startswith(
        "Installing build/"
    ):
        # Safety net: if "Built build/..." never arrived, the Gradle
        # spinner would otherwise stay open forever.
        if gradle_started and not gradle_completed:
            complete_spinner(
                "Gradle build complete",
                gradle_duration,
            )

            gradle_completed = True

        if not install_started:
            start_spinner(
                "Installing app...",
                PURPLE,
            )

            install_started = True

        # Some Flutter versions put the duration on this line.
        duration = extract_duration(
            text
        )

        if duration:
            install_duration = duration

        return

    # Flutter may emit the install duration alone:
    #
    # Installing build/...apk...
    # 693ms
    #
    if (
        install_started
        and not install_completed
        and re.fullmatch(
            r"[0-9][0-9,]*(?:\.[0-9]+)?(?:ms|s)",
            text,
        )
    ):
        install_duration = text

        complete_spinner(
            "App installed",
            install_duration,
        )

        install_completed = True
        return

    # --------------------------------------------------------
    # Sync
    # --------------------------------------------------------

    if "Syncing files to device" in text:
        # Safety net for builds that skip both "Built build/..." and
        # the install step (e.g. attaching to an already installed
        # app), so Gradle still gets closed out.
        if gradle_started and not gradle_completed:
            complete_spinner(
                "Gradle build complete",
                gradle_duration,
            )

            gradle_completed = True

        if (
            install_started
            and not install_completed
        ):
            complete_spinner(
                "App installed",
                install_duration,
            )

            install_completed = True

        if not sync_started:
            # Spinner, not a committed line: stop_spinner() clears the
            # row so complete_spinner() can replace it in place. A
            # plain line() here would leave the yellow row in
            # scrollback with the green result printed below it.
            start_spinner(
                "Syncing files...",
                YELLOW,
            )

            sync_started = True

        return

    # --------------------------------------------------------
    # Flutter interactive session
    # --------------------------------------------------------

    if "Flutter run key commands" in text:
        if (
            sync_started
            and not sync_completed
        ):
            complete_spinner(
                "Files synced",
            )

            sync_completed = True
        else:
            stop_spinner()

        if not interactive_ready:
            line(
                "  ✓ Interactive session ready",
                GREEN + BOLD,
            )

            interactive_ready = True

            # Build summary. Platform-agnostic: the total covers the
            # whole run, and the platform-specific stage time is
            # whichever of Gradle/Xcode actually ran.
            line()

            total = format_elapsed(
                time.monotonic() - build_started_at
            )

            if pods_duration:
                line(
                    f"  Σ CocoaPods      {pods_duration}",
                    CYAN,
                )

            if gradle_duration:
                line(
                    f"  Σ Gradle build   {gradle_duration}",
                    CYAN,
                )

            if xcode_duration:
                line(
                    f"  Σ Xcode build    {xcode_duration}",
                    CYAN,
                )

            if install_duration:
                line(
                    f"  Σ Install        {install_duration}",
                    CYAN,
                )

            line(
                f"  Σ Total build    {total}",
                CYAN + BOLD,
            )

            # Blank line so the countdown gets a line of its own. The
            # countdown redraws with \r + erase-to-end-of-line, so
            # without this it would sit on, and repeatedly wipe, the
            # last summary line.
            line()

            # Hold the log stream so the summary above stays on
            # screen. The IO loop does the actual release.
            if LOG_DELAY > 0:
                app_logs_at = (
                    time.monotonic() + LOG_DELAY
                )

            else:
                start_app_logs()

        return

    # --------------------------------------------------------
    # Hide Flutter help
    # --------------------------------------------------------

    if is_flutter_help(text):
        return

    # --------------------------------------------------------
    # Hot reload / hot restart
    # --------------------------------------------------------
    # Keyed off Flutter's output rather than off the keypress, so a
    # reload/restart that frun didn't initiate still reports properly
    # instead of spilling raw progress text into the log stream.

    for marker, kind in ACK_MARKERS:
        if text.startswith(marker):
            ack_pending(kind)
            return

    if (
        "Restarted application in" in text
        or "Hot restart performed" in text
    ):
        finish_pending(
            "restart",
            extract_duration(text),
        )

        return

    if (
        text.startswith("Reloaded ")
        or "Hot reload performed" in text
    ):
        finish_pending(
            "reload",
            extract_duration(text),
        )

        return

    if pending_kind is not None and PAUSED_STATUS_RE.match(text):
        # A status, not a log line, so print it once rather than on every
        # redraw. Worth surfacing: it's the reason the stage is slow, and
        # a reload while paused may not visibly update the UI.
        if text != pending_notice:
            pending_notice = text

            line(
                f"  ◇ {text}",
                FAINT,
            )

        return

    if pending_kind is not None:
        # Flutter accepted the key but the operation did not land.
        #
        # It reports the cause itself over several lines and then closes
        # with "Try again after fixing the above error(s)." (printed for
        # any non-ok result, see _commonTerminalInputHandler). So note
        # the reason, let Flutter's own lines through, and put the
        # verdict last - after the errors it refers to, not before.

        if (
            text.startswith("Hot reload was rejected")
            or text.startswith("Hot restart was rejected")
        ):
            note_pending_failure("rejected")
            native(text)
            return

        if "Unable to hot reload application" in text:
            note_pending_failure("unrecoverable error, use R")
            native(text)
            return

        if (
            "hot restart failed to complete" in text
            or "hot reload failed to complete" in text
        ):
            note_pending_failure("failed to complete")
            native(text)
            return

        if "Try again after fixing the above error" in text:
            # Superseded by the ✗ line, which carries the same advice.
            fail_pending(
                pending_failure or "see the errors above"
            )

            return

    # --------------------------------------------------------
    # Application/native logs
    # --------------------------------------------------------

    # Gate on app_logs_started, not interactive_ready: those used to
    # flip together, but the log release is now delayed, and anything
    # arriving in between still has to be held back.
    if app_logs_started:
        native(text)
    else:
        buffer_log(text)


# ============================================================
# IO loop
# ============================================================
try:
    while True:
        # Only use a select timeout while something needs ticking (the
        # app-log countdown, or an unacknowledged reload/restart).
        # Otherwise block.
        deadlines = [
            at
            for at in (
                app_logs_at,
                pending_ack_at,
            )
            if at is not None
        ]

        timeout = None

        if deadlines:
            timeout = min(
                0.2,
                max(
                    0.0,
                    min(deadlines) - time.monotonic(),
                ),
            )

        readable, _, _ = select.select(
            [
                master_fd,
                stdin_fd,
            ],
            [],
            [],
            timeout,
        )

        # ----------------------------------------------------
        # Unacknowledged reload/restart
        # ----------------------------------------------------
        # Flutter never picked the key up, so nothing is coming that
        # could close this stage.

        if (
            pending_ack_at is not None
            and time.monotonic() >= pending_ack_at
        ):
            drop_pending()

        # ----------------------------------------------------
        # Countdown before releasing app logs
        # ----------------------------------------------------
        # Redraws in place on its own line, so it leaves no trace
        # once the logs are released.

        if app_logs_at is not None:
            remaining = (
                app_logs_at - time.monotonic()
            )

            if remaining <= 0:
                app_logs_at = None

                write(CLEAR_LINE)
                start_app_logs()

            else:
                write(
                    f"{CLEAR_LINE}{FAINT}"
                    f"  ◇ App logs in "
                    f"{remaining:.0f}s"
                    f"{describe_held()}"
                    f"{RESET}"
                )

        # ----------------------------------------------------
        # Flutter -> frun
        # ----------------------------------------------------
        # ----------------------------------------------------

        if master_fd in readable:
            try:
                data = os.read(
                    master_fd,
                    4096,
                )

            except OSError:
                break

            if not data:
                break

            text = data.decode(
                "utf-8",
                errors="ignore",
            )

            text = text.replace(
                "\r\n",
                "\n",
            )

            text = text.replace(
                "\r",
                "\n",
            )

            buffer += text

            while "\n" in buffer:
                current_line, buffer = (
                    buffer.split(
                        "\n",
                        1,
                    )
                )

                process_line(
                    current_line
                )

            # Flutter's progress message never ends in a newline, so the
            # ack lives in this leftover tail.
            check_pending_ack(buffer)

        # ----------------------------------------------------
        # Keyboard -> Flutter
        # ----------------------------------------------------

        if stdin_fd in readable:
            data = os.read(
                stdin_fd,
                1024,
            )

            if not data:
                break

            if interactive_ready:

                if data in (b"r", b"R", b"q"):
                    # Reaching for the keyboard ends the summary pause;
                    # otherwise the countdown and the spinner would be
                    # drawing on the same row.
                    release_app_logs_now()

                if data == b"r":
                    request_pending("reload")

                elif data == b"R":
                    request_pending("restart")

                elif data == b"q":
                    clear_pending()
                    stop_spinner()

                    # ⏏, matching the Quit row in frun's HOT
                    # CONTROLS. This is the graceful path: Flutter
                    # gets the key and shuts itself down.
                    line(
                        "⏏ Quitting Flutter...",
                        FAINT,
                    )

            # Always forward the original key.
            os.write(
                master_fd,
                data,
            )


# ============================================================
# Ctrl+C
# ============================================================

except KeyboardInterrupt:
    stop_spinner()

    # ⏹, matching the Stop row in frun's HOT CONTROLS. Distinct
    # from the q path above: this is an interrupt, and SIGINT is
    # forwarded to Flutter below rather than Flutter deciding to
    # exit on its own.
    line(
        "⏹ Stopping Flutter...",
        FAINT,
    )

    try:
        os.kill(
            pid,
            signal.SIGINT,
        )

    except ProcessLookupError:
        pass


# ============================================================
# Cleanup
# ============================================================

finally:
    stop_spinner()

    # If we exited while the log release was still pending, wipe the
    # countdown and flush whatever was held so it isn't lost.
    if app_logs_at is not None:
        app_logs_at = None
        write(CLEAR_LINE)

    if startup_logs and not app_logs_started:
        start_app_logs()

    restore_terminal()

    try:
        os.close(
            master_fd
        )

    except OSError:
        pass


# ============================================================
# Child exit
# ============================================================

try:
    _, status = os.waitpid(
        pid,
        0,
    )

    if os.WIFEXITED(
        status
    ):
        sys.exit(
            os.WEXITSTATUS(
                status
            )
        )

    if os.WIFSIGNALED(
        status
    ):
        sys.exit(
            128
            + os.WTERMSIG(
                status
            )
        )

except ChildProcessError:
    pass