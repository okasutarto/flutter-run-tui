# ============================================================
# Colors
# ============================================================
# Read from frun-theme.zsh rather than duplicated here. The two
# files had drifted: "CYAN" meant 117 in this file and 39 in
# frun.zsh, and errors were 203 here but 196 there, so the same
# state was two different colours depending on which process
# printed it.
#
# Only the FRUN_C_<ROLE>=<code> lines are parsed; everything else
# in the theme file is ignored. Falls back to the values that
# were hardcoded here, so running frun-runner directly still
# works if the theme file is missing.

THEME_DEFAULTS = {
    "ACCENT": 39,
    "HEAD": 117,
    "OK": 82,
    "WARN": 220,
    "STAGE": 212,
    "ERR": 203,
}


def load_theme():
    codes = dict(THEME_DEFAULTS)

    path = os.path.join(
        os.path.dirname(
            os.path.abspath(__file__)
        ),
        "frun-theme.zsh",
    )

    try:
        with open(path) as handle:
            for raw in handle:
                line = raw.strip()

                if not line.startswith("FRUN_C_"):
                    continue

                name, _, value = line.partition("=")

                if not value.isdigit():
                    continue

                codes[name[len("FRUN_C_"):]] = int(value)

    except OSError:
        pass

    return codes


_THEME = load_theme()


def _sgr(role):
    return "\033[38;5;%dm" % _THEME[role]


RESET = "\033[0m"
BOLD = "\033[1m"
FAINT = "\033[2m"

# Role names kept alongside the old identifiers so the rest of
# this file reads the same. CYAN here has always been the section
# heading colour, which is HEAD.
CYAN = _sgr("HEAD")
GREEN = _sgr("OK")
YELLOW = _sgr("WARN")
PURPLE = _sgr("STAGE")
RED = _sgr("ERR")

CLEAR_LINE = "\r\033[K"

# ============================================================
# Separator width
# ============================================================
# render_frun_header sizes the card to its content and exports the
# result, so the rule drawn before APP LOGS lines up with the card
# printed further up the screen. It used to be a 49-column
# literal here and another in frun.zsh, neither tied to the card.


def rule_width():
    try:
        width = int(os.environ.get("FRUN_RULE_W", ""))
    except ValueError:
        width = 0

    if width < 8:
        # Standalone run, or a stale environment. Fall back to the
        # terminal, then to the old fixed width.
        try:
            width = os.get_terminal_size().columns - 2
        except OSError:
            width = 49

    return max(8, min(width, 200))


RULE = "─" * rule_width()

SPINNER_FRAMES = [
    "⠋", "⠙", "⠹", "⠸", "⠼",
    "⠴", "⠦", "⠧", "⠇", "⠏",
]


# ============================================================
# Settings
# ============================================================

# Pause between the build summary and the app log stream. Without it a
# chatty app scrolls the summary out of view the moment it starts. The
# countdown is drawn only after the whole summary is on screen, and
# logs keep buffering while it runs, so nothing is lost.
#
# Override with FRUN_LOG_DELAY (seconds). 0 disables the pause.
try:
    LOG_DELAY = max(
        0.0,
        float(
            os.environ.get(
                "FRUN_LOG_DELAY",
                "5",
            )
        ),
    )

except ValueError:
    LOG_DELAY = 5.0


# How long to wait for Flutter to acknowledge an r/R keypress before
# assuming it was dropped.
#
# Flutter discards terminal input while it is busy with a previous
# command, and it does so silently: processTerminalInput() only emits a
# printTrace(), which never reaches stdout. Same story when the device
# can't hot restart (`supportsRestart`/`hotMode` false). So a keypress
# is a request, not a fact, and the spinner it starts needs a way out.
#
# The ack is Flutter's own "Performing hot restart/reload..." progress
# message. It appears within milliseconds when the key is accepted, but
# the timeout is generous because runSourceGenerators() runs first and
# a false timeout is self-correcting: a late ack simply reopens the
# stage.
#
# Override with FRUN_ACK_TIMEOUT (seconds).
try:
    ACK_TIMEOUT = max(
        0.5,
        float(
            os.environ.get(
                "FRUN_ACK_TIMEOUT",
                "4",
            )
        ),
    )

except ValueError:
    ACK_TIMEOUT = 4.0


# How long a stage runs before its spinner starts showing a clock.
#
# Once Flutter has acknowledged an r/R there is no timeout to apply: a
# reload can legitimately take a while, and a big restart much longer,
# so claiming failure would be a lie. Showing the elapsed time instead
# keeps the row visibly moving and lets the difference between "slow"
# and "stuck" be read at a glance.
ELAPSED_AFTER = 3.0


# ============================================================
# ANSI cleanup
# ============================================================

ANSI_RE = re.compile(
    r"""
    \x1B
    (?:
        [@-Z\\-_]
        |
        \[
        [0-?]*
        [ -/]*
        [@-~]
    )
    """,
    re.VERBOSE,
)

LITERAL_ANSI_RE = re.compile(
    r"""
    (?:
        \\x1[bB]\[
        |
        \^\[\[
        |
        \\033\[
    )
    [0-9;?]*[A-Za-z]
    """,
    re.VERBOSE,
)


# Flutter's spinner animations are drawn from the braille block, and it
# erases each frame with backspaces rather than CR (see
# AnonymousSpinnerStatus in flutter_tools/lib/src/base/logger.dart).
# Whatever survives the backspace replay is a leftover frame.
#
# Anchored, and requires at least one braille character, so ordinary
# leading whitespace (indented log lines) is left alone.
SPINNER_JUNK_RE = re.compile(
    r"^[ \t]*[\u2800-\u28FF][\u2800-\u28FF \t]*"
)

# The mirror case: a status line that was flushed while its animation
# frame was still on screen keeps that frame at the end.
SPINNER_TAIL_RE = re.compile(
    r"[ \t]*[\u2800-\u28FF][\u2800-\u28FF \t]*$"
)

BRAILLE_ONLY_RE = re.compile(
    r"^[\u2800-\u28FF\s]*$"
)


def apply_backspaces(text):
    """Replay '\\b' as a destructive backspace.

    Flutter animates a progress line in place with
    '\\b' + next-frame, and pads/erases with
    '\\b' * n + ' ' * n + '\\b' * n. Those bytes reach us verbatim, so
    without replaying them the raw frames end up printed as garbage in
    the log stream.
    """

    if "\b" not in text:
        return text

    out = []

    for char in text:
        if char == "\b":
            if out:
                out.pop()

            continue

        out.append(char)

    return "".join(out)


def clean_ansi(text):
    text = ANSI_RE.sub("", text)
    text = LITERAL_ANSI_RE.sub("", text)
    text = apply_backspaces(text)

    # A progress line that got interrupted by a log line leaves its last
    # animation frame glued to the front of that log line, and a status
    # line flushed mid-animation keeps one at the end.
    text = SPINNER_JUNK_RE.sub("", text)
    text = SPINNER_TAIL_RE.sub("", text)

    return text


# ============================================================
# Output
# ============================================================

output_lock = threading.Lock()


def write(text):
    with output_lock:
        os.write(
            sys.stdout.fileno(),
            text.encode(
                "utf-8",
                errors="replace",
            ),
        )


# Committed lines always start by reclaiming the current row.
#
# A spinner (and the app-log countdown) draws in place with no trailing
# newline, so anything printed while one is live would otherwise be
# appended to that row and inherit its leftovers. CLEAR_LINE is a no-op
# on a row that is already empty, so this is safe unconditionally.


def line(text="", color=""):
    write(
        f"{CLEAR_LINE}{color}{text}{RESET}\r\n"
    )


def native(text):
    if not text:
        return

    text = clean_ansi(text)

    if not text:
        return

    write(
        f"{CLEAR_LINE}{text}\r\n"
    )


# ============================================================
# Spinner
# ============================================================

spinner_running = False
spinner_thread = None
spinner_lock = threading.Lock()

# Bumped on every start. stop_spinner() joins with a timeout, so a
# spinner thread that is slow to wake (blocked writing to a stalled
# terminal, say) can outlive the stop and then see spinner_running flip
# back to True for the *next* spinner. Without a generation check that
# stale thread keeps drawing its own label forever, alongside the new
# one, which reads as a wedged spinner.
spinner_generation = 0


def spinner_is_running():
    with spinner_lock:
        return spinner_running


def start_spinner(label, color=YELLOW, show_elapsed=False):
    """Animate `label` in place until stopped.

    `show_elapsed` appends a running clock once the stage passes
    ELAPSED_AFTER. Frames alone cycle through a fixed set, so a spinner
    that is genuinely working looks identical to one that is wedged; the
    clock is the difference. It matters most for hot reload and hot
    restart, where the only honest answer to "is this still going?" is
    that Flutter has acknowledged the key and hasn't reported back yet.
    """

    global spinner_running
    global spinner_thread
    global spinner_generation

    stop_spinner()

    with spinner_lock:
        spinner_generation += 1
        generation = spinner_generation
        spinner_running = True

    started = time.monotonic()

    def run():
        index = 0

        while True:
            with spinner_lock:
                if not spinner_running:
                    break

                if generation != spinner_generation:
                    break

            frame = SPINNER_FRAMES[
                index % len(SPINNER_FRAMES)
            ]

            suffix = ""

            if show_elapsed:
                elapsed = time.monotonic() - started

                if elapsed >= ELAPSED_AFTER:
                    suffix = f"  {format_clock(elapsed)}"

            write(
                f"{CLEAR_LINE}"
                f"{color}"
                f"  {frame} {label}{suffix}"
                f"{RESET}"
            )

            index += 1
            time.sleep(0.08)

    spinner_thread = threading.Thread(
        target=run,
        daemon=True,
    )

    spinner_thread.start()


def stop_spinner():
    global spinner_running
    global spinner_thread

    with spinner_lock:
        spinner_running = False

    if spinner_thread is not None:
        spinner_thread.join(
            timeout=0.2
        )
        spinner_thread = None

    write(CLEAR_LINE)


def complete_spinner(
    label,
    duration="",
):
    stop_spinner()

    suffix = ""

    if duration:
        suffix = f"  {duration}"

    line(
        f"  ✓ {label}{suffix}",
        GREEN + BOLD,
    )


# ============================================================
# Buffered app logs
# ============================================================

startup_logs = []
app_logs_started = False

# Monotonic deadline for releasing the buffered app logs, or None
# when no release is pending. Driven by the select() timeout in the
# IO loop so reading from the pty never stalls.
app_logs_at = None


def describe_held():
    pending = len(startup_logs)

    if not pending:
        return ""

    return f"  ({pending} buffered)"


def buffer_log(text):
    if not text:
        return

    startup_logs.append(text)


def release_app_logs_now():
    """Cut the hold short and flush.

    Called when the user reaches for the keyboard: once they interact,
    the pause protecting the build summary has served its purpose, and
    leaving it running would put the countdown and a reload/restart
    spinner on the same row, fighting over it.
    """

    global app_logs_at

    if app_logs_at is not None:
        app_logs_at = None
        write(CLEAR_LINE)

    start_app_logs()


def start_app_logs():
    global app_logs_started

    if app_logs_started:
        return

    app_logs_started = True
    
    line()

    line(RULE, FAINT)

    line()

    line(
        "◆ APP LOGS",
        CYAN + BOLD,
    )

    line()

    # Flush everything emitted by the application while
    # Flutter was still completing the launch process.
    for buffered in startup_logs:
        native(buffered)

    startup_logs.clear()


# ============================================================
# Helpers
# ============================================================

GRADLE_TASK_RE = re.compile(
    r"Running Gradle task '([^']+)'"
)


# Flutter formats elapsed milliseconds through NumberFormat, so the
# value carries a group separator: "Restarted application in 1,234ms."
# Matching only [0-9]+ here used to clip that to "234ms".
DURATION_RE = re.compile(
    r"([0-9][0-9,]*(?:\.[0-9]+)?(?:ms|s))"
)


def extract_duration(text):
    match = DURATION_RE.search(text)

    if match:
        return match.group(1)

    return ""


def extract_gradle_task(text):
    match = GRADLE_TASK_RE.search(text)

    if match:
        return match.group(1)

    return ""


def format_elapsed(seconds):
    if seconds < 60:
        return f"{seconds:.1f}s"

    minutes = int(seconds // 60)
    rest = seconds - (minutes * 60)

    return f"{minutes}m {rest:.1f}s"


def format_clock(seconds):
    """Whole seconds, for a value that redraws several times a second."""

    seconds = int(seconds)

    if seconds < 60:
        return f"{seconds}s"

    return f"{seconds // 60}m {seconds % 60:02d}s"


def is_progress_artifact(text):
    if not text:
        return True

    # Flutter sometimes leaves tiny spinner/progress fragments
    # after CR-based terminal updates.
    if len(text) <= 8 and not any(
        char.isalnum()
        for char in text
    ):
        return True

    # A line that is nothing but animation frames.
    if BRAILLE_ONLY_RE.match(text):
        return True

    return False


def is_flutter_help(text):
    return (
        text.startswith("r Hot reload")
        or text.startswith("R Hot restart")
        or text.startswith("h List all")
        or text.startswith("d Detach")
        or text.startswith("c Clear")
        or text.startswith("q Quit")
    )


